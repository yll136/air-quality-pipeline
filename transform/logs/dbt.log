create or replace view
    "awsdatacatalog"."airquality"."stg_measurements"
  as
    with source as (
    select * from "awsdatacatalog"."airquality"."measurements_raw"
),

typed as (
    select
        sensor_id,
        location_id,
        location_name,
        lat,
        lon,
        parameter,
        units,
